# ==============================================================================
# SpeakSharp Environment Configuration (.env.example)
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Free Tier: https://supabase.com)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (safe for frontend & client usage)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SECRET: Backend only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# AI Provider Configuration (Zero-Cost / OpenAI Compatible)
# ------------------------------------------------------------------------------
# Provider mode:
# - "mock"     : 100% free offline demo mode. No API key needed. Realistic word timestamps + AI coach feedback simulation.
# - "groq"     : 100% free cloud API (Whisper-large-v3 + Llama 3 models with word timestamps, no credit card required).
# - "openai"   : Official OpenAI API (paid credits required).
AI_PROVIDER=mock

# Base URL for OpenAI SDK (e.g. https://api.groq.com/openai/v1 for Groq, or https://api.openai.com/v1 for OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1

# API Key (Groq key starting with gsk_ for free, or OpenAI key sk-...; optional if AI_PROVIDER=mock)
OPENAI_API_KEY=

# Speech-to-Text Model:
# - OpenAI: whisper-1
# - Groq (Free): whisper-large-v3 or whisper-large-v3-turbo
OPENAI_STT_MODEL=whisper-1

# LLM Coaching Model:
# - OpenAI: gpt-4o-mini
# - Groq (Free): llama-3.3-70b-versatile or llama-3.1-8b-instant
OPENAI_LLM_MODEL=gpt-4o-mini

# Text-to-Speech Model:
# - OpenAI: gpt-4o-mini-tts or tts-1
# - Web/Client: If no key or mock, frontend uses native browser Web Speech Synthesis (100% free, high quality on iOS/Safari/Mac)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# ------------------------------------------------------------------------------
# Backend API Server Configuration
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Rate limiting (per day per user)
RATE_LIMIT_PER_DAY=20
RATE_LIMIT_ANON_PER_DAY=5

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite requires VITE_ prefix)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

